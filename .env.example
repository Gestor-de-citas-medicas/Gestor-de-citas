# ─────────────────────────────────────────────────────────────
# MAMP — Environment Variables Template
# Copy this file to .env and fill in all required values.
# NEVER commit the real .env file to Git.
# ─────────────────────────────────────────────────────────────

# ── Django Core ──────────────────────────────────────────────
# Generate a secure key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-very-secret-and-random-key-here

# Set to False in production!
DEBUG=False

# Comma-separated list of allowed hosts (EC2 public IP or domain)
# Example: ALLOWED_HOSTS=ec2-xx-xx-xx-xx.compute.amazonaws.com,yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Email (Gmail SMTP) ───────────────────────────────────────
# Use a Gmail App Password — NOT your regular Gmail password.
# Get one at: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# ── AI Chatbot ───────────────────────────────────────────────
# Provider options: groq | openai | gemini
AI_PROVIDER=groq

# API key for the chosen provider
AI_API_KEY=your-api-key-here

# Model name — examples by provider:
#   Groq:   llama-3.1-8b-instant, llama3-70b-8192, mixtral-8x7b-32768
#   OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#   Gemini: gemini-2.0-flash, gemini-1.5-pro
AI_MODEL=llama-3.1-8b-instant

# ── CSRF (for HTTPS / custom domain) ─────────────────────────
# Comma-separated trusted origins. Required when running behind HTTPS.
# Example: CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CSRF_TRUSTED_ORIGINS=
